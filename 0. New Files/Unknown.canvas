		{
			"id":"3e2d523c9314a20e",
			"type":"text",
			"text":"# Area Info\n\nThis area is unlocked by doing the Castling Chess Puzzle in The Precipice.\n\nTo do it, you should draw rooms with all chess pieces.\nThen you need to place them on board to solve the puzzle.\nYou are allowed to pick a piece to give you a permanent power until you solve the puzzle again.\nPick Rook / King and then solve it again picking King / Rook, changing from the previous piece.\n\nThis is the almost the same as castling in chess since you are swaping both pieces of positions.\n\n[[Precipice Castle Chess Puzzle.canvas|Precipice Castle Chess Puzzle]]",
			"styleAttributes":{},
			"x":-620,
			"y":-200,
			"width":620,
			"height":420
		},

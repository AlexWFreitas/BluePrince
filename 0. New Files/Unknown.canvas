		{
			"id":"f7af44e4c44c7321",
			"type":"text",
			"text":"# Solution\nCIX = 01:09\nADD = ADD the number below\nSIX = 01:15\nTOR = Rotate Anti-Clockwise (Inverse of ROT)\nLOR = Word\nETT = East\n\nRotate minute pointer to East",
			"styleAttributes":{},
			"x":-9640,
			"y":5340,
			"width":360,
			"height":320
		},

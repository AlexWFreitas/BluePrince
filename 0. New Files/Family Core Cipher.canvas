			"height":60
		},
		{
			"id":"94e4783a79f8dab0",
			"type":"text",
			"text":"[[With Without Puzzles.canvas|With Without Puzzles]]",
			"styleAttributes":{},
			"x":-989,
			"y":1720,
			"width":260,
			"height":60
		},
		{
			"id":"5bfb4ed813cae254",
			"type":"text",
			"text":"Some of the words appear on the paintings, I feel that the paintings hold the secret for this puzzle.",
			"styleAttributes":{},
			"x":-1507,
			"y":1800,
			"width":478,
			"height":80
		},
		{
			"id":"8d152227e5ddf235",
			"type":"text",
			"text":"I should try to place the grid with 44 characters from the Mansion and try to place a character for each painting in a way that it fits this cipher, maybe each word represents a character in the alphabet.",
			"styleAttributes":{},
			"x":-1507,
			"y":1900,
			"width":478,
			"height":120
		},

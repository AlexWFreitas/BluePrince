			"height":140,
			"color":"4"
		},
		{
			"id":"5ee5bfb675dfe6ef",
			"type":"text",
			"text":"Access the emails on the terminal in the [[024 - Office.canvas|024 - Office]] using the password and read about the [[031 - Utility Closet.canvas|031 - Utility Closet]] VAC Indicators mechanics",

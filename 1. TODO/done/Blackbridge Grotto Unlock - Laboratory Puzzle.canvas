{
	"nodes":[
		{
			"id":"5053063adbe69b3d",
			"type":"text",
			"text":"Draft a [[032 - Boiler Room.canvas|032 - Boiler Room]] and then use it to power up the [[036 - Laboratory.canvas|036 - Laboratory]] room.",
			"styleAttributes":{},
			"x":-640,
			"y":-300,
			"width":360,
			"height":100,
			"color":"4"
		},
		{
			"id":"1a6922e8dd52000d",
			"type":"text",
			"text":"# Rewards\n\n- Access to the [[Blackbridge Grotto.canvas|Blackbridge Grotto]] area\n- Access to the [[Blackbridge Grotto.canvas|Blackbridge Grotto]] permanent bonus\n\t- You can access one offline terminal per run from another terminal you find.",
			"styleAttributes":{},
			"x":-140,
			"y":-100,
			"width":500,
			"height":240,
			"color":"4"
		},
		{
			"id":"fe6e219ac0f81a94",
			"type":"text",
			"text":"Transcribe the marked numbers on the Periodic Table to the element symbols to create a message",
			"styleAttributes":{},
			"x":-620,
			"y":-160,
			"width":320,
			"height":120,
			"color":"4"
		},
		{
			"id":"e34e8029d1f623c6",
			"type":"text",
			"text":"The message says **\"Push three up after nine\"**",
			"styleAttributes":{},
			"x":-590,
			"y":20,
			"width":260,
			"height":80,
			"color":"4"
		},
		{
			"id":"215a3dc2efd70f2f",
			"type":"text",
			"text":"Do what the message says on the machine powered in the [[036 - Laboratory.canvas|036 - Laboratory]] with many levers that was powered up by the [[032 - Boiler Room.canvas|032 - Boiler Room]].",
			"styleAttributes":{},
			"x":-670,
			"y":160,
			"width":420,
			"height":140,
			"color":"4"
		},
		{
			"id":"e218f2b24223ea91",
			"type":"text",
			"text":"This will unlock the [[Blackbridge Grotto.canvas|Blackbridge Grotto]] permanent upgrade",
			"styleAttributes":{},
			"x":-650,
			"y":360,
			"width":380,
			"height":100,
			"color":"4"
		}
	],

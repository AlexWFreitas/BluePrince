			"text":"[[044 - Aquarium.canvas|044 - Aquarium]]",
			"styleAttributes":{},
			"x":-580,
			"y":-280,
			"width":260,
			"height":60
		},
		{
			"id":"8e1a10cb1dfd691a",
			"type":"text",
			"text":"If you drain the water on the Aquarium, it shows some marked spots on layouts that remember existing draftable rooms",
			"styleAttributes":{},
			"x":-620,
			"y":-180,
			"width":340,
			"height":140
		},
		{
			"id":"036769e6b1ca47ba",
			"type":"text",
			"text":"It's possible that drafting those rooms on a Treasure Map spot will allow you to dig on those spots and find a unique treasure",
			"styleAttributes":{},
			"x":-630,
			"y":0,
			"width":360,
			"height":140
		},

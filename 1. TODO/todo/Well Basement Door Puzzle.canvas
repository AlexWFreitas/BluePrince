			"width":420,
			"height":100
		},
		{
			"id":"2a7ce29fa7e9a716",
			"type":"text",
			"text":"After draining it we need to retrieve a [[Basement Key.canvas|Basement Key]], from the [[045 - Antechamber.canvas|045 - Antechamber]] room.",
			"styleAttributes":{},
			"x":-680,
			"y":-160,
			"width":420,
			"height":100
		},
		{
			"id":"6c8238220a84e77a",
			"type":"text",
			"text":"This key can be used to open the door that is under the [[Well.canvas|Well]], unlocking a pathway to the [[Basement.canvas|Basement]]",

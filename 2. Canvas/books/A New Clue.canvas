			"y":-1520,
			"width":260,
			"height":60
		},
		{
			"id":"ecde8a48f6a37366",
			"type":"text",
			"text":"# Nook",
			"styleAttributes":{},
			"x":4233,
			"y":-1520,
			"width":260,
			"height":60
		},
		{"id":"cdfc7fd2f66e8ef6","type":"file","file":"99. attachments/BLUE_PRINCE_2JocOkUq0w.jpg","x":3784,"y":-1420,"width":400,"height":225},
		{"id":"b32ea2816f528e30","type":"file","file":"99. attachments/BLUE_PRINCE_pdqezf3fGL.png","x":4233,"y":-1420,"width":400,"height":312},
		{
			"id":"453bbf23e0163747",
			"type":"text",
			"text":"No tome after tome that the Library loaned.\nAnd the books that he had that he already owned.\nWere searched from their **covers** all the **way through**\nIf he found a new clue, he would know what to do.",
			"styleAttributes":{},
			"x":2930,
			"y":-721,
			"width":496,
			"height":141,
			"color":"4"
		},
		{"id":"a2e950f207198e71","type":"file","file":"99. attachments/BLUE_PRINCE_NwGKLFRNB7.png","x":2869,"y":312,"width":400,"height":268},
		{"id":"47ce4568c4ff5119","type":"file","file":"99. attachments/BLUE_PRINCE_36hE7ZtuNE.png","x":2870,"y":86,"width":399,"height":190},
		{
			"id":"f13fe7d767d95bf7",
			"type":"text",
			"text":"Suspect is Minor - Less than Age 18",
			"styleAttributes":{},
			"x":1304,
			"y":2140,
			"width":260,
			"height":60
		},
		{"id":"0707fd59ee9d15a5","type":"file","file":"99. attachments/BLUE_PRINCE_zAbW0tlM5m.png","x":700,"y":2140,"width":400,"height":253},
		{
			"id":"922ae7aa9058d3c6",
			"type":"text",
			"text":"Bo Lee - Age 16 (Minor) and Small Name, this means that this name is useful for the [[Blackbridge Grotto Hidden Logins Puzzle.canvas|Blackbridge Grotto Hidden Logins Puzzle]]",
			"styleAttributes":{},
			"x":720,
			"y":2460,
			"width":360,
			"height":140
		},
		{
			"id":"4f7457ffd7f0e4fd",
			"type":"text",
			"text":"[[A New Clue - Original Manuscript.canvas|A New Clue - Original Manuscript]]",
			"styleAttributes":{},
			"x":2440,
			"y":-850,
			"width":260,
			"height":60
		},
		{
			"id":"0823e18217bb395c",
			"type":"text",
			"text":"# A New Clue - Low Case Clues\n\nOn Page 5:\n\n1 - All\n2 - Checked\n3 - Corner\n4 - Case\n5 - Rooms\n6 - Had\n7 - A\n8 - Low\n9 - Case\n10 - Clue\n11 - Found\n12 - In\n13 - The\n14 - Rooms\n\n**Patio** - **buried**\n**Nook** - **beside**\n**Office** - **west**\n**Pantry** - **bridgette**\n",
			"styleAttributes":{},
			"x":2740,
			"y":-1420,
			"width":500,
			"height":655,
			"color":"4"
		},
		{
			"id":"b4bd4e8be2ff6878",
			"type":"text",
			"text":"TENDER CIPHER = THE RED PRINCE\nUNCLE AWE = A NEW CLUE\nDRAFT THE SIXES = THE FIXED STARS\nLUNAR RENAMED = REALM AND RUNE\n\nASSUME THAT PAGE COUNT STARTS ON TITLE PAGES\n\n",
			"styleAttributes":{},
			"x":2930,
			"y":-560,
			"width":620,
			"height":190,
			"color":"4"
		},
		{
			"id":"4ebb56c6d0d61c97",
			"type":"text",
			"text":"# Wrong Solution\n\nRED -  PAGE A WORD X = Clue Low\nGREEN - PAGE C WORD A = The Clue\nVIOLET - PAGE B WORD Y = All A\nBLUE - PAGE Z WORD X = Corner Low",
			"styleAttributes":{},
			"x":2400,
			"y":-742,
			"width":500,
			"height":182,
			"color":"1"
		},
		{
			"id":"b0d40eadd6fc4935",
			"type":"text",
			"text":"# The Suspect is Major\nMA|JOR KEY = MA|JOR = Small Name?\nKey = Password or Login",
			"styleAttributes":{},
			"x":920,
			"y":-765,
			"width":420,
			"height":143,
			"color":"4"
		}
	],

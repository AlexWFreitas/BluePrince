		{"id":"1e1258b1a6822f6d","type":"file","file":"99. attachments/BLUE_PRINCE_a69A0AkCgt.png","x":3300,"y":86,"width":347,"height":399},
		{
			"id":"d2d4484d4ab4d76f",
			"type":"text",
			"text":"A = 1\nB = 2\nC = 3\nX = 24\nY = 25\nZ = 26",
			"styleAttributes":{},
			"x":2320,
			"y":-460,
			"width":120,
			"height":180,
			"color":"1"
		},
		{
			"id":"d6bae8738a5d397d",
			"type":"text",
			"text":"X = 1\nY = 2\nZ = 3\nA = 4\nB = 5\nC = 6",
			"styleAttributes":{},
			"x":2460,
			"y":-460,
			"width":120,
			"height":180,
			"color":"1"
		},
		{
			"id":"b38e1ab41da3f1f1",
			"type":"text",
			"text":"# Theories\n1. New Clue book says that four books are relevant\n\t1. The Red Prince\n\t2. A New Clue\n\t3. The Fixed Stars\n\t4. Realm & Rune\n2. The book also says that we should look from the cover all the way through.\n3. Page count starts from the Title Page (unsure if before or after)\n4. If you use the Magnifying Glass on the words of the book, there are small numbers in it\n5. The page X and word Y is referring to numbers based on the signs in the book that tell you to record each stop number.",
			"styleAttributes":{},
			"x":1970,
			"y":-1720,
			"width":749,
			"height":360,
			"color":"4"
		},
		{"id":"c8c8b83b6f515984","type":"file","file":"99. attachments/BLUE_PRINCE_8orIns2Kga.png","x":-1840,"y":-400,"width":400,"height":225},
		{"id":"8b6addff69ac1007","type":"file","file":"99. attachments/BLUE_PRINCE_hzSZTtdu6z.png","x":1160,"y":-1440,"width":782,"height":440},
		{
			"id":"04280b3d6b34b456",
			"type":"text",
			"text":"# Metro Stops\n1. 8 - Royal Station\n2. 7 - Angel Tower\n3. 3 - Aries Crossing\n4. 10 - Tanner Fork\n5. 1 - Oris Train Hall\n6. 13- Dead End",
			"styleAttributes":{},
			"x":1400,
			"y":-980,
			"width":542,
			"height":260,
			"color":"4"
		},
		{"id":"54d010aa961e1812","type":"file","file":"99. attachments/BLUE_PRINCE_Gh6ka0vqOE.png","x":3320,"y":-1330,"width":400,"height":281},
		{
			"id":"5a570a23c87d4043",
			"type":"text",
			"text":"# The Suspect Is Minor\nThis is related to the fact that one of the suspect names that is minor by age is important for a certain clue.",
			"styleAttributes":{},
			"x":1400,
			"y":-685,
			"width":542,
			"height":125,
			"color":"4"
		},
		{"id":"d1b77b53253a76cd","type":"file","file":"99. attachments/BLUE_PRINCE_JXuhH4xihX.png","x":3320,"y":-1622,"width":400,"height":225},
		{
			"id":"6bd9a56e731c4dd5",
			"type":"text",
			"text":"# Signs in the Book\n\nRoute 8\nDepart \nKeep Left\nTo Tanner Fork\nTurn Right\nDead End\nRecord\nEach\nStop\nOn The Way\n",
			"styleAttributes":{},
			"x":1970,
			"y":-1330,
			"width":749,
			"height":360,
			"color":"4"
		},
		{

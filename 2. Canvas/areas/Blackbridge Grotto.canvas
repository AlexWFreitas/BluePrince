		{
			"id":"e79a220c6aab6418",
			"type":"text",
			"text":"From these logs, one of the guys who accessed this terminal is the Detective that was the inspiration for the Clues book?",
			"styleAttributes":{},
			"x":760,
			"y":930,
			"width":340,
			"height":140
		},

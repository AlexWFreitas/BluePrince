			"type":"text",
			"text":"Eraja Nai - Eraja Night\n\nElcountvo - Me Count Away (Old Answer)\n\nLeavelu - Leave you not\n\n**Le - I am not**\n",
			"styleAttributes":{},
			"x":4040,
			"y":19780,
			"width":300,

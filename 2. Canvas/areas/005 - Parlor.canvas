		{"id":"d5be8910d91aa12d","type":"file","file":"99. attachments/BLUE_PRINCE_gQFOeSDKNa.png","x":-160,"y":1280,"width":400,"height":225},
		{"id":"507cbd372393bd9d","type":"file","file":"99. attachments/BLUE_PRINCE_pDuBdyqS0B.png","x":-1501,"y":1640,"width":400,"height":152},
		{"id":"bbd4ffdc8df8d441","type":"file","file":"99. attachments/BLUE_PRINCE_AVZbccV98i.png","x":-1060,"y":1640,"width":400,"height":210},
		{"id":"56b202167b959bfc","type":"file","file":"99. attachments/BLUE_PRINCE_Z234TbJs1v.png","x":-620,"y":1620,"width":400,"height":202},
		{"id":"55167217567c468c","type":"file","file":"99. attachments/BLUE_PRINCE_8HpTFXdIcY.png","x":-160,"y":1620,"width":400,"height":293},
		{
			"id":"879a53d87db718c9",
			"type":"text",
			"text":"The gems are in the white box\nThe other two statements are both true\nThe gems are not in the blue box",
			"styleAttributes":{},
			"x":-1920,
			"y":-20,
			"width":380,
			"height":135
		},
		{
			"id":"82be2036eec505fc",
			"type":"text",
			"text":"The gems are in the only box with a true statement\nOne of the other boxes is true\nThe gems are in the only box with a false statement",
			"styleAttributes":{},
			"x":-1940,
			"y":479,
			"width":400,
			"height":180
		},
		{
			"id":"331b5000a62b28c9",
			"type":"text",
			"text":"The gems are in another box\nThe truth is on another box\nThe words another box are on another box",
			"styleAttributes":{},
			"x":-1960,
			"y":940,
			"width":380,
			"height":140
		},
		{
			"id":"a6c8cc48c81fbb05",
			"type":"text",
			"text":"There is only one true statement\nThe gems are in a box with a false statement\nThere are two true statements",
			"styleAttributes":{},
			"x":-1940,
			"y":1300,
			"width":360,
			"height":140
		},
		{
			"id":"b1bfc06debc0af95",
			"type":"text",
			"text":"There are two true boxes\nThere are two empty boxes\nThis box is empty",
			"styleAttributes":{},
			"x":-1960,
			"y":1640,
			"width":380,
			"height":120
		},
		{"id":"0c7f665f793c8d5b","type":"file","file":"99. attachments/BLUE_PRINCE_wRv43B9uDO.png","x":-1680,"y":1970,"width":400,"height":180,"color":"4"},
		{"id":"6d271003210fbb75","type":"file","file":"99. attachments/BLUE_PRINCE_PWnjWKqxDE.png","x":-1240,"y":1927,"width":399,"height":223,"color":"1"},
		{"id":"2101e9e86fa92159","type":"file","file":"99. attachments/BLUE_PRINCE_rwX980PaIC.png","x":-800,"y":1948,"width":399,"height":181,"color":"1"},
		{
			"id":"7ac02bf4bf95d68d",
			"type":"text",
			"text":"The gems are in the black box\nEvery statement with the word black is false\nThe gems are in the blue box",
			"styleAttributes":{},
			"x":-1980,
			"y":1950,
			"width":260,
			"height":200
		},
		{"id":"b6960ee4a817d2bf","type":"file","file":"99. attachments/BLUE_PRINCE_P5Ecp5DJos.png","x":-360,"y":1984,"width":400,"height":289},
		{
			"id":"9e780a1ab68a29c8",
			"type":"text",
			"text":"A box with a false statement contains the gems\nThe statement on the blue box is true\nThe blue box contains the gems",
			"styleAttributes":{},
			"x":-1980,
			"y":2240,
			"width":260,
			"height":220
		},
		{"id":"9d4a35577f73b042","type":"file","file":"99. attachments/BLUE_PRINCE_uda1hOooyC.png","x":-1680,"y":2240,"width":400,"height":227,"color":"4"},
		{"id":"023a7787ffa2652e","type":"file","file":"99. attachments/BLUE_PRINCE_CWdO5WbRnC.png","x":-1241,"y":2240,"width":400,"height":153,"color":"4"},
		{"id":"c89e95e4a799ad78","type":"file","file":"99. attachments/BLUE_PRINCE_b7X5On04nZ.png","x":-820,"y":2264,"width":400,"height":203,"color":"1"},

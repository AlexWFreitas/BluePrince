		{"id":"fc78bd6f55ba42e2","type":"file","file":"99. attachments/BLUE_PRINCE_4DnoF6vEwj.png","x":-1500,"y":1280,"width":399,"height":254},
		{"id":"d790846c7ee56ece","type":"file","file":"99. attachments/BLUE_PRINCE_gZGEe3Wzn4.png","x":-1060,"y":1266,"width":400,"height":268},
